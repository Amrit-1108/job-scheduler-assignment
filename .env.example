# Docker Compose (the db service):
DATABASE_URL=postgresql+psycopg2://scheduler:YOUR_POSTGRES_PASSWORD@db:5432/scheduler
# Running the app on the host against a locally installed Postgres instead:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/scheduler
# Test database (pytest creates it if missing):
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/scheduler_test
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POLL_INTERVAL_SECONDS=2
BATCH_SIZE=10
WORKER_CONCURRENCY=4
LEASE_SECONDS=60
RETRY_BACKOFF_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=300
FAILURE_RATE=0.3

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-something-random-and-32-bytes
ACCESS_TOKEN_MINUTES=60